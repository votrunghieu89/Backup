<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="TMDT22_9_2025.TMDT_Lazada.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background-color: #f3f4f6;
        }

        .container {
            width: 100%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== HEADER ===== */
        header {
            background: linear-gradient(90deg, #ff7700, #ff5500);
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 60px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        header .logo img {
            height: 65px;
            transition: 0.3s;
        }

        header .logo img:hover {
            transform: scale(1.08);
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 40px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            font-size: 17px;
            transition: 0.25s;
            padding: 6px 10px;
            border-radius: 6px;
        }

        nav ul li a:hover {
            background-color: rgba(255,255,255,0.25);
        }

        /* ===== BANNER ===== */
        .banner {
            height: 260px;
            width: 100%;
            border-radius: 0;
            margin-top: 5px;
            overflow: hidden;
            position: relative;
            background: #000;
        }

        .banner img {
            width: 100%;
            height: 260px;
            object-fit: cover;
            filter: brightness(0.82);
        }

        .banner::after {
            content: "SHOPPING MALL";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 40px;
            font-weight: bold;
            text-shadow: 2px 2px 6px rgba(0,0,0,0.5);
        }

        /* ===== MAIN AREA ===== */
        .main {
            display: flex;
            flex: 1;
            margin: 25px 60px;
            gap: 20px;
        }

        /* SIDEBAR */
        .sidebar {
            width: 25%;
            background-color: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(0,0,0,0.08);
            min-height: 420px;
            font-size: 20px;
        }

        .sidebar div {
            padding: 10px 0;
        }

        .sidebar a {
            text-decoration: none !important;
            color: #333;
            font-size: 18px;
            font-weight: bold;
            transition: 0.3s;
            display: block;
            padding: 10px;
            border-radius: 6px;
        }

        .sidebar a:hover {
            background-color: #ffefe0;
            color: #ff5500;
        }

        /* CONTENT BLOCK */
        .content {
            width: 75%;
            background-color: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(0,0,0,0.08);
            min-height: 420px;
        }

        /* ===== FOOTER ===== */
        footer {
            background-color: #111;
            color: white;
            text-align: center;
            padding: 22px 0;
            font-size: 15px;
            margin-top: 30px;
            letter-spacing: 1px;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 850px) {
            header {
                flex-direction: column;
                padding: 15px 20px;
                text-align: center;
            }

            nav ul {
                flex-direction: column;
                gap: 12px;
                margin-top: 10px;
            }

            .main {
                flex-direction: column;
                margin: 20px;
            }

            .sidebar, .content {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">
        <div class="container">

            <!-- HEADER -->
            <header>
                <asp:HyperLink class="logo" ID="HyperLink1" runat="server" NavigateUrl="~/TMDT_Lazada/17_11_2025/Home.aspx">
                    <asp:Image ID="Image1" runat="server" ImageUrl="~/TMDT_Lazada/Image/R-removebg-preview.png" />
                </asp:HyperLink>

                <nav>
                    <ul>
                        <li><asp:HyperLink ID="HyperLink2" runat="server" NavigateUrl="~/TMDT_Lazada/17_11_2025/Home.aspx">Home</asp:HyperLink></li>
                        <li><asp:HyperLink ID="HyperLink3" runat="server" NavigateUrl="~/TMDT_Lazada/17_11_2025/Product.aspx">Don Hang</asp:HyperLink></li>
                        <li><asp:HyperLink ID="HyperLink4" runat="server" NavigateUrl="~/MaHang.aspx">Ma Hang</asp:HyperLink></li>
                        <li><asp:HyperLink ID="HyperLink5" runat="server" NavigateUrl="~/LoaiHang.aspx">Loai Hang</asp:HyperLink></li>
                        <li><asp:HyperLink ID="HyperLink6" runat="server" NavigateUrl="~/KhachHang.aspx">Khach Hang</asp:HyperLink></li>
                    </ul>
                </nav>
            </header>

            <!-- BANNER -->
            <div class="banner">
                <asp:Image ID="Image2" runat="server" ImageUrl="~/TMDT_Lazada/Image/img2.png"/>
            </div>

            <!-- MAIN CONTENT -->
            <div class="main">

                <!-- Sidebar -->
                <div class="sidebar">
                    <asp:DataList ID="DataList1" runat="server">
                         <ItemTemplate>
                            <div>
                              <asp:HyperLink 
                                ID="HyperLink7" 
                                runat="server"
                                Text='<%# Eval("TenLoaiHang") %>'
                                NavigateUrl='<%# "ListProductById.aspx?maLoaiHang=" + Eval("maLoaiHang") %>'>
                              </asp:HyperLink>
                            </div>
                        </ItemTemplate>
                    </asp:DataList>
                </div>

                <!-- CONTENT FROM CHILD PAGES -->
                <div class="content">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                </div>

            </div>

            <!-- FOOTER -->
            <footer>
                ALOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOO
            </footer>

        </div>
    </form>
</body>
</html>
